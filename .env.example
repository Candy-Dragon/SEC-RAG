# 复制本文件为 .env 后填写（Phase 4 跑实验前需要）

# 生成与证据约束模型；本地评价模型由evaluation/ollama_client.py配置
MODEL_PROVIDER=openai
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=1024

# 数据与知识库存储根目录
STORAGE_ROOT=storage

# Optional independent knowledge base and domain scope (project-relative)
KNOWLEDGE_BASE_ROOT=
EXPERIMENT_SCOPE_PATH=configs/experiment_scope.json
